fun isPrime(n) {

    if (n < 2) {
        return false;
    }

    let i = 2;

    while (i * i <= n) {

        if (n % i == 0) {
            return false;
        }

        i = i + 1;
    }

    return true;
}

let i = 2;

while (i <= 20) {

    if (isPrime(i)) {
        print i;
    }

    i = i + 1;
}