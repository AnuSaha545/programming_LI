fun binarySearch(arr, target) {

    let left = 0;
    let right = 4;

    while (left <= right) {

        let mid = (left + right) / 2;

        if (arr[mid] == target) {
            return mid;
        }

        if (arr[mid] < target) {
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }

    return -1;
}

let nums = [1,2,3,4,5];

print binarySearch(nums,4);